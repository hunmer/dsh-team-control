{
  "name": "dsh-team-control-ui",
  "version": "0.1.4",
  "type": "module",
  "description": "dsh-team dashboard inside the DSH Web UI: live member board, DAG, event timeline, permission matrix and scope approvals, proxied same-origin to the local sidecar.",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "agent-team",
    "dashboard",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hunmer/dsh-team-control.git"
  },
  "homepage": "https://github.com/hunmer/dsh-team-control#readme",
  "bugs": {
    "url": "https://github.com/hunmer/dsh-team-control/issues"
  },
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
