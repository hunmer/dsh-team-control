{
  "name": "dsh-team-control",
  "version": "0.3.1",
  "type": "module",
  "description": "Expose the local dsh-team sidecar as model-facing tools (dsh_team_create / dsh_team_spawn / dsh_team_status / dsh_team_task / dsh_team_send / dsh_team_report_task / dsh_team_dispatch / dsh_team_control / dsh_team_approve / dsh_team_report), spawn real DSH sub-agent members with per-member permission presets, forward member approvals to the Lead, and manage the sidecar lifecycle.",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "agent-team",
    "orchestration",
    "tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hunmer/dsh-team-control.git"
  },
  "homepage": "https://github.com/hunmer/dsh-team-control#readme",
  "bugs": {
    "url": "https://github.com/hunmer/dsh-team-control/issues"
  },
  "license": "MIT",
  "dependencies": {
    "dsh-team-control-cli": "^0.3.1"
  },
  "exports": {
    ".": "./index.js",
    "./changes.js": "./changes.js",
    "./pricing.js": "./pricing.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "changes.js",
    "pricing.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
